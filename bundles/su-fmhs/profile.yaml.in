# The SU/FMHS profile as a published bundle. Generated by build.sh — edit this
# template, not the generated profile.yaml.
schema_version: 2
name: su-fmhs
version: "@VERSION@"
engine: thesis-assemble
description: >-
  Stellenbosch University, Faculty of Medicine and Health Sciences: a hybrid PhD
  thesis (examination, submission and library copies). The rulebook is the
  template plus the pipeline in pipeline/, both from revision @REV@ of the
  thesis repository.
aliases: [@ALIASES@]
requires:
  quarto: ">=1.7.31"
